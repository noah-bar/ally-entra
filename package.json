{
  "name": "@hxtc/ally-entra",
  "description": "Microsoft Entra ID driver for AdonisJS Ally",
  "version": "0.1.0",
  "main": "build/index.js",
  "exports": {
    ".": "./build/index.js",
    "./types": "./build/src/types.js"
  },
  "type": "module",
  "files": [
    "build",
    "!build/bin",
    "!build/tests"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run lint && npm run typecheck",
    "clean": "del-cli build",
    "copy:templates": "copyfiles \"stubs/**/*.stub\" build",
    "build": "npm run clean && tsc && npm run copy:templates",
    "quick:test": "node --enable-source-maps --import=@poppinss/ts-exec bin/test.ts",
    "test": "c8 npm run quick:test",
    "prepublishOnly": "npm test && npm run build"
  },
  "devDependencies": {
    "@adonisjs/ally": "^6.3.2",
    "@adonisjs/assembler": "^8.6.0",
    "@adonisjs/core": "^7.6.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/runner": "^5.4.0",
    "@poppinss/ts-exec": "^1.5.1",
    "@types/node": "^24.19.2",
    "c8": "^12.0.0",
    "copyfiles": "^2.4.1",
    "del-cli": "^8.0.1",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@adonisjs/ally": "^6.3.2",
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/assembler": "^8.0.0"
  },
  "author": "noah-bar",
  "license": "MIT",
  "keywords": [
    "adonisjs",
    "adonisjs-ally",
    "ally",
    "azure-ad",
    "entra-id",
    "microsoft",
    "microsoft-entra",
    "oauth2",
    "oidc",
    "social-auth"
  ],
  "prettier": "@adonisjs/prettier-config",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "jose": "^6.2.15"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noah-bar/ally-entra.git"
  },
  "bugs": {
    "url": "https://github.com/noah-bar/ally-entra/issues"
  },
  "homepage": "https://github.com/noah-bar/ally-entra#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**",
      "bin/**"
    ]
  },
  "peerDependenciesMeta": {
    "@adonisjs/assembler": {
      "optional": true
    }
  }
}
